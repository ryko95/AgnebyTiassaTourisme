<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/toolbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_agneby" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/toolbar_title"
            android:textColor="@color/green_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnReload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/action_button"
            android:clickable="true"
            android:contentDescription="@string/action_reload"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/action_button"
            android:clickable="true"
            android:contentDescription="@string/action_share"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_share" />

        <ImageView
            android:id="@+id/btnExit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/exit_button"
            android:clickable="true"
            android:contentDescription="@string/action_exit"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_exit" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/orange_primary"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/bottom_nav_background"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout android:id="@+id/navHome" android:layout_width="78dp" android:layout_height="66dp" android:layout_margin="3dp" android:background="@drawable/nav_item_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@string/nav_home" android:src="@drawable/ic_home" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_home" android:textColor="@color/text_dark" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navSites" android:layout_width="78dp" android:layout_height="66dp" android:layout_margin="3dp" android:background="@drawable/nav_item_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@string/nav_sites" android:src="@drawable/ic_place" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_sites" android:textColor="@color/text_dark" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navMap" android:layout_width="78dp" android:layout_height="66dp" android:layout_margin="3dp" android:background="@drawable/nav_item_map_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/nav_map" android:src="@drawable/ic_map" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/nav_map" android:textColor="@color/green_dark" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navExperiences" android:layout_width="92dp" android:layout_height="66dp" android:layout_margin="3dp" android:background="@drawable/nav_item_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@string/nav_experiences" android:src="@drawable/ic_explore" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_experiences" android:textColor="@color/text_dark" android:textSize="10.5sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navFeatured" android:layout_width="84dp" android:layout_height="66dp" android:layout_margin="3dp" android:background="@drawable/nav_item_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@string/nav_featured" android:src="@drawable/ic_featured" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_featured" android:textColor="@color/text_dark" android:textSize="10.5sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navMarketplace" android:layout_width="96dp" android:layout_height="66dp" android:layout_margin="3dp" android:background="@drawable/nav_item_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@string/nav_marketplace" android:src="@drawable/ic_store" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_marketplace" android:textColor="@color/text_dark" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navContact" android:layout_width="78dp" android:layout_height="66dp" android:layout_margin="3dp" android:background="@drawable/nav_item_background" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@string/nav_contact" android:src="@drawable/ic_mail" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_contact" android:textColor="@color/text_dark" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
